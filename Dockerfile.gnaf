FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Kombu's Redis extra installs packaging and requires redis-py >= 6.4.
RUN pip install flask==3.1.3 psycopg2-binary==2.9.13 celery==5.3.4 kombu[redis]==5.7.0 redis==6.4.0

COPY GNAF_search_api.py .
COPY celery_config.py .

EXPOSE 5001

CMD ["python", "GNAF_search_api.py"]
