FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install urllib3==2.8.0 elasticsearch==7.17.13

# Copy indexing script
COPY es_index_multi_docker.py .
COPY data/ ./data/

# Wait for Elasticsearch and then index data
CMD ["python", "es_index_multi_docker.py"]
